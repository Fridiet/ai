# MySQL 비밀번호에 특수문자가 있으면 URL 인코딩해야 합니다.
# 로컬 모델 파일과 requirements-ocr-experiment.txt 설치 후 true로 전환합니다.
OCR_CLASSIFIER_ENABLED=false
OCR_CLASSIFIER_MANIFEST=output/ocr_normalizer_experiment_v25/model.json
OCR_CLASSIFIER_THREADS=2

DATABASE_URL=mysql+pymysql://fridiet_ai:change-me@localhost:3306/Fridiet?charset=utf8mb4

# 로컬 개발에서만 true 사용을 권장합니다. 공유 DB는 migrations SQL을 직접 적용하세요.
DATABASE_AUTO_CREATE=false

# 식품안전나라 데이터활용서비스에서 발급한 COOKRCP01 OpenAPI 인증키
# 레시피 데이터셋 갱신 스크립트에서만 사용하며 서버 실행에는 필요하지 않습니다.
MFDS_API_KEY=

# AI가 직접 DB에 접근하는 레거시 API 전용 서버 간 인증값(32자 이상).
# 비어 있으면 해당 API는 503으로 차단됩니다. 프론트엔드에 노출하지 마세요.
# /ocr 및 Spring이 호출하는 /api/recipes/ai에는 필요하지 않습니다.
AI_SERVICE_TOKEN=

# PC/cloud public gateway: run app.public_server:create_public_app --factory.
# Unlike local app.main:app, all published business routes require the token.
# Only OCR, recipe preview and container estimate are exposed; DB writes/docs blocked.
# Use ONE worker. These demo limits reset after a process restart, not a billing cap.
# 0 disables the corresponding request quota; authentication/concurrency stay enabled.
AI_PUBLIC_REQUESTS_PER_MINUTE=0
AI_PUBLIC_REQUESTS_PER_DAY=0
AI_PUBLIC_QUEUE_TIMEOUT_SECONDS=30
AI_PUBLIC_MAX_PENDING=4
OCR_STARTUP_WARMUP=true
OCR_CPU_THREADS=2
OCR_LLM_CACHE_ENABLED=true
AI_PUBLIC_CONCURRENCY=2

# Opt-in backend-only DB persistence for Spring singular-table schema.
# DATABASE_URL must point to the SAME DB used by the backend.
# Do not enable before checking app.team_ocr_database.require_schema(). No auto DDL.
AI_DB_SCHEMA=team
AI_DB_WRITE_ENABLED=false
# Different from AI_SERVICE_TOKEN. Never send either key to an app/browser.
AI_DB_SERVICE_TOKEN=

# Container photo estimation. Server-only credentials; never put these in Expo env.
OPENAI_API_KEY=
OPENAI_CONTAINER_MODEL=gpt-5.4-mini
# Text-only optional correction; enable only after verified-label evaluation.
OCR_LLM_ENABLED=false
OPENAI_OCR_MODEL=gpt-5.4-mini
OCR_LLM_TIMEOUT_SECONDS=8
# Missing dates only: conditional GPT storage reminders, never verified expiry dates.
OCR_SHELF_LIFE_LLM_ENABLED=true

# OCR 검출 장변 제한: 0=기존 원본 설정, 960=비교 실험용 축소 검출.
# 인식용 원본 사진은 유지합니다. 설정 변경 후 AI 서버를 재시작하세요.
OCR_DETECTION_MAX_SIDE=0
# Optional second OCR pass for named food rows with unverified purchase counts.
# Adds latency; raw OCR and inventory-save routes are unaffected.
OCR_SECONDARY_COUNTS_ENABLED=false
# Optional confirmation hints only; never auto-promotes unknown names.
OCR_SECONDARY_NAME_HINTS_ENABLED=false
